# Jal Drishti — environment template
# Copy to .env.local and fill in. .env* is gitignored; never commit a real key.
# Every external call has a timeout and a fallback, so the app runs fully
# without any of these — you lose the feature, not the page.

# ─── Vision resolver (photo input) ──────────────────────────────────────────
# Set ONE of these. Without either, the scan screen says so and offers manual
# search instead of showing a dead button.
#
# GEMINI (recommended): free tier, no card required, good with Indian produce.
#   Get a key in ~2 minutes at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Leave blank to use the built-in fallback chain (recommended): quota is counted
# per model, so when one runs dry the next answers automatically.
GEMINI_MODEL=

# CLAUDE: stronger reasoning, paid.
ANTHROPIC_API_KEY=

# Force one provider. Leave blank to auto-detect (Gemini preferred if both set).
VISION_PROVIDER=

# ─── Speech (voice input) ───────────────────────────────────────────────────
# "web" uses the browser's built-in Web Speech API: no key, no network, works
# offline. "bhashini" uses India's national language stack.
SPEECH_PROVIDER=web
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# ─── Open Food Facts (barcode) ──────────────────────────────────────────────
# No key required. They throttle anonymous clients, so we send a descriptive
# User-Agent and back off on 429 — see resolvers/barcode.ts.

# ─── Phase 8: on-chain label anchoring (optional) ───────────────────────────
# Leave blank to use the SQLite-style hash chain fallback (see chain/README.md).
POLYGON_AMOY_RPC_URL=
WATER_LABEL_CONTRACT_ADDRESS=
LABEL_ISSUER_PRIVATE_KEY=
